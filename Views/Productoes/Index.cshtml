@model IEnumerable<Parcial1_Prog3.Models.Producto>

@{
    ViewData["Title"] = "Index";
}

@if (!Model.Any())
{
    <div class="alert alert-warning">
        Aún no se cargó ningún producto.
    </div>
    <a asp-action="Create" class="btn btn-primary">Crear nuevo producto</a>
}
else
{
        <h1>Lista de Productos</h1>

    <p>
        <a asp-action="Create">Agregar Nuevo Producto</a>
    </p>
    <div class="alert alert-info">
        <strong>Total de productos:</strong> @ViewBag.TotalProductos <br />
        <strong>Favoritos:</strong> @ViewBag.Favoritos
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Precio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Categoria)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Marca)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Favorito)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Precio)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Categoria)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Marca)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Favorito)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        @*<a asp-action="Details" asp-route-id="@item.Id">Details</a>*@ |
                        <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    


}

